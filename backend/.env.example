# Server
PORT=3000

# MongoDB (local)
MONGODB_URI=mongodb://127.0.0.1:27017/tourism_booking

# Backblaze B2 S3-Compatible API credentials
# Find these in your Backblaze B2 account under "App Keys"
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET_NAME=your-bucket-name
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key

# Admin credentials
# ADMIN_USERNAME: choose any username
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH: generate with:  node -e "const b=require('bcryptjs');b.hash('yourpassword',10).then(h=>console.log(h))"
ADMIN_PASSWORD_HASH=$2a$10$examplehashreplacethiswithreal

# Session secret: generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string
